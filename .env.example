# ---------- 基础 ----------
# 注意：Docker Compose 会把 $ 当作变量，SECRET_KEY 里不要含 $，或写成 $$ 转义
SECRET_KEY=change-me-use-python-secrets-token-urlsafe-50-chars-minimum-length
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.93.129
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://192.168.93.129:8000
WEB_PORT=8000

# ---------- MySQL（docker-compose 内 db 服务） ----------
MYSQL_ROOT_PASSWORD=201314
MYSQL_DATABASE=ai_listing
MYSQL_USER=ai_listing
MYSQL_PASSWORD=201314
MYSQL_PORT=3306

# Django 数据库（与上面 MySQL 配置对应；本地 runserver 用 127.0.0.1 + root 亦可）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_listing
DB_USER=root
DB_PASSWORD=201314

# ---------- 站点 URL（生图 media 公网引用等，走 Nginx 对外端口） ----------
SITE_BASE_URL=http://192.168.93.129:8000
NANO_BANANA_MEDIA_PUBLIC_BASE=http://192.168.93.129:8000/media
SERVE_MEDIA=false
USE_X_FORWARDED_HOST=true
USE_X_FORWARDED_PROTO=false

# ---------- 邮件（忘记密码） ----------
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=2510927347@qq.com
EMAIL_HOST_PASSWORD=pyvrwcmqpvqzdjhc
DEFAULT_FROM_EMAIL=2510927347@qq.com

# ---------- OpenAI / 代理 ----------
OPENAI_API_KEY=sk-vzcf3MNFhMoveatXo88kt74Cspu1CB5ao4Uh4reoulooV2cI
OPENAI_BASE_URL=https://api.openai-proxy.org/v1
OPENAI_MODEL=gpt-5.1
OPENAI_VISION_MODEL=gpt-4o
OPENAI_READ_TIMEOUT=1200
OPENAI_CONNECT_TIMEOUT=60

# ---------- Nano Banana 生图 ----------
NANO_BANANA_API_URL=https://grsai.dakka.com.cn/v1/api/generate
NANO_BANANA_API_KEY=sk-8a6dc9f2e6cf4c43907011d2215e3b52
NANO_BANANA_IMAGES_PER_MODULE=3
# 单次批量生图最多新生成 48 张（已有成品图不计入；需继续则再次点击）
NANO_BANANA_MAX_IMAGES_PER_RUN=48
NANO_BANANA_MODULE_WORKERS=6
NANO_BANANA_API_SEMAPHORE_PER_USER=6
# 全站 API 上限（10 用户 × 6 路；需 Redis 跨进程生效）
NANO_BANANA_API_SEMAPHORE_GLOBAL=60
NANO_BANANA_BATCH_STAGGER_SEC=0.3
NANO_BANANA_HTTP_RETRIES=1
NANO_BANANA_ENABLE_TOPUP=false
NANO_BANANA_VARIANT_MAX_RETRIES=1
NANO_BANANA_HTTP_TIMEOUT=360
# 内网/服务器不能访问公网时设为 false：本地上传的主图/A+/原生图均以 base64 传给生图 API
NANO_BANANA_PREFER_URL_REFS=false

# ---------- Redis / Celery（阶段 B/C：全站限流 + 异步 worker + 运维） ----------
# Docker 部署：compose 已固定为 redis://redis:6379/0，.env 里勿写 127.0.0.1
# 本地 runserver（非 Docker、本机有 Redis）时用：
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_URL=
REDIS_PROTOCOL=2
# 本地 runserver 无 worker 时：不设 CELERY_TASK_ALWAYS_EAGER 也会自动走 Web 后台线程 + 进度轮询
# 若需 Celery 同步调试可设：CELERY_TASK_ALWAYS_EAGER=true
NANO_BANANA_USE_REDIS_SEMAPHORE=true
NANO_BANANA_ASYNC_BATCH=true
CELERY_WORKER_CONCURRENCY=10
# 高优队列在前（管理员/staff）；可水平扩展：docker compose up -d --scale worker=2
CELERY_WORKER_QUEUES=image_gen_high,image_gen
CELERY_IMAGE_GEN_QUEUE=image_gen
CELERY_IMAGE_GEN_QUEUE_HIGH=image_gen_high
# 任务在队列中超过该秒数仍未被 worker 领取则报错（默认 45）
IMAGE_GEN_PENDING_TIMEOUT_SEC=45
# 停止生图时是否 SIGTERM 强杀 worker 子进程（默认 false，避免槽位泄漏）
IMAGE_GEN_CANCEL_TERMINATE=false
# API 并发槽位等待超时（秒），超时后会报错而非一直卡住
NANO_BANANA_SEMAPHORE_ACQUIRE_TIMEOUT=120
# 管理员每用户 API 并发（普通用户见 NANO_BANANA_API_SEMAPHORE_PER_USER）
NANO_BANANA_API_SEMAPHORE_PER_USER_SUPERUSER=8
# 可选 Flower 监控：docker compose --profile ops up -d
FLOWER_PORT=5555

